---
import Layout from "../../layouts/Layout.astro";
import ContentImageSplit from "../../components/ContentImageSplit.astro";
import t from "../../i18n/es.json";
---

<Layout
  title="Érika Morales Andrade | Abogada Colegiada en Fuengirola y Málaga"
  description="Abogada colegiada por el ICAM, licenciada por la Universidad Complutense de Madrid. Especialista en extranjería y derecho civil en la Costa del Sol. Conoce mi trayectoria."
  lang="es"
>
  <div class="page-header">
    <div class="container">
      <h1>{t.aboutpage.title}</h1>
      <p class="intro" set:html={t.aboutpage.intro} />
    </div>
  </div>

  <ContentImageSplit
    title={t.aboutpage.philosophyTitle}
    imageSrc="/erika1_1.jpg"
    imageAlt="Imagen conceptual sobre la filosofía del despacho"
  >
    <p set:html={t.aboutpage.philosophyText} />
  </ContentImageSplit>

  <ContentImageSplit
    title={t.aboutpage.experienceTitle}
    imageSrc="/erika2.jpg"
    imageAlt="Imagen conceptual sobre experiencia y dedicación"
    reverse={true}
  >
    <p set:html={t.aboutpage.experienceText} />
  </ContentImageSplit>
</Layout>

<style>
  .page-header {
    background-color: var(--color-light-gray);
    padding: 3rem 0;
    text-align: center;
    border-bottom: 1px solid #ddd;
  }
  .page-header .intro {
    max-width: 700px;
    margin: 1rem auto 0 auto;
    font-size: 1.15rem;
  }
</style>
