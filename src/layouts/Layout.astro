                            itemListElement: [
                                {
                                    "@type": "Offer",
                                    itemOffered: {
                                        "@type": "LegalService",
                                        name: "Derecho de Extranjería y Nacionalidad Española",
                                        description: "Especialistas en Nacionalidad Española por residencia, opción y Ley de Memoria Democrática. Arraigo social, laboral y familiar. Reagrupación Familiar, Tarjeta Comunitaria y Visados de Oro.",
                                    },
                                },
                                {
                                    "@type": "Offer",
                                    itemOffered: {
                                        "@type": "LegalService",
                                        name: "Derecho Civil y Contratos",
                                        description: "Reclamaciones de cantidad, contratos de alquiler y compraventa, desahucios y responsabilidad civil.",
                                    },
                                },
                                {
                                    "@type": "Offer",
                                    itemOffered: {
                                        "@type": "LegalService",
                                        name: "Derecho de Familia y Sucesiones",
                                        description: "Divorcios, medidas de custodia, pensiones de alimentos, herencias y testamentos.",
                                    },
                                },
                                {
                                    "@type": "Offer",
                                    itemOffered: {
                                        "@type": "LegalService",
                                        name: "Derecho Penal",
                                        description: "Defensa en juicios rápidos, delitos leves, alcoholemias y violencia de género. Asistencia al detenido 24 horas.",
                                    },
                                },
                            ],
                        },
                    },
                    {
                        "@type": "WebSite",
                        "@id": `${siteBase}/#website`,
                        url: siteBase,
                        name: "Erika Morales Abogada",
                        description: "Abogada especialista en extranjería, derecho civil y penal en Fuengirola y Costa del Sol",
                        inLanguage: ["es-ES", "en-GB", "fr-FR", "ja-JP"],
                        publisher: { "@id": `${siteBase}/#lawfirm` },
                        potentialAction: {
                            "@type": "SearchAction",
                            target: {
                                "@type": "EntryPoint",
                                urlTemplate: `${siteBase}/es/servicios`,
                            },
                            "query-input": "required name=search_term_string",
                        },
                    },
                ],
            })}
        />
    </head>
    <body>
        <Header currentLang={lang} />

        <main>
            <slot />
        </main>

        <Footer currentLang={lang} />
        <WhatsAppButton />
    </body>
</html>
