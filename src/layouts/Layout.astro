                        url: siteBase,
                        logo: {
                            "@type": "ImageObject",
                            url: `${siteBase}/logo_erika.png`,
                        },
                        image: `${siteBase}/fondo.jpg`,
                        telephone: "+34635041999",
                        email: "erikamorales@icamalaga.org",
                        sameAs: [
                            "https://www.linkedin.com/in/erika-lizeth-morales-andrade/",
                        ],
