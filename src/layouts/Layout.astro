                            addressLocality: "Fuengirola",
                            postalCode: "29649",
                            addressRegion: "Málaga",
                            addressCountry: "ES",
                        },
                        geo: {
                            "@type": "GeoCoordinates",
                            latitude: "36.5414",
                            longitude: "-4.6234",
                        },
                        areaServed: [
                            { "@type": "City", name: "Fuengirola" },
                            { "@type": "City", name: "Málaga" },
                            { "@type": "AdministrativeArea", name: "Costa del Sol" },
                            { "@type": "City", name: "Madrid" },
                            { "@type": "Country", name: "España" },
